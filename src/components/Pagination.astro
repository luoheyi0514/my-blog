---
interface Props {
  current: number;
  totalPages: number;
  basePath: string;
  query?: string;
}

const { current, totalPages, basePath, query = '' } = Astro.props;

const href = (page: number) => {
  const clean = basePath.replace(/\/$/, '');
  const path = page <= 1 ? clean || '/' : `${clean}/page/${page}`;
  return query ? `${path}?${query}` : path;
};

const pages: (number | '…')[] = [];
if (totalPages <= 7) {
  for (let i = 1; i <= totalPages; i += 1) pages.push(i);
} else {
  pages.push(1);
  if (current > 3) pages.push('…');
  for (let i = Math.max(2, current - 1); i <= Math.min(totalPages - 1, current + 1); i += 1) pages.push(i);
  if (current < totalPages - 2) pages.push('…');
  pages.push(totalPages);
}
---

{
  totalPages > 1 && (
    <nav class="mt-10 flex items-center justify-center gap-1.5" aria-label="分页">
      {current > 1 ? (
        <a href={href(current - 1)} class="btn btn-sm">
          上一页
        </a>
      ) : (
        <span class="btn btn-sm cursor-not-allowed opacity-40">上一页</span>
      )}

      {pages.map((page) =>
        page === '…' ? (
          <span class="px-1 text-xs text-muted">…</span>
        ) : (
          <a
            href={href(page)}
            aria-current={page === current ? 'page' : undefined}
            class:list={[
              'flex h-8 min-w-8 items-center justify-center rounded-md px-2 text-xs transition',
              page === current
                ? 'bg-text font-medium text-bg'
                : 'border border-line text-muted hover:text-text',
            ]}
          >
            {page}
          </a>
        ),
      )}

      {current < totalPages ? (
        <a href={href(current + 1)} class="btn btn-sm">
          下一页
        </a>
      ) : (
        <span class="btn btn-sm cursor-not-allowed opacity-40">下一页</span>
      )}
    </nav>
  )
}
