---
import type { TocItem } from '../lib/types';

interface Props {
  toc: TocItem[];
}

const { toc } = Astro.props;
---

{
  toc.length >= 3 && (
    <>
      <div class="mb-6 lg:hidden">
        <details class="card px-4 py-3">
          <summary class="cursor-pointer text-xs font-medium text-muted">目录（{toc.length} 节）</summary>
          <nav class="mt-3 space-y-0.5">
            {toc.map((item) => (
              <a href={`#${item.slug}`} class={`toc-link ${item.depth === 3 ? 'depth-3' : ''}`}>
                {item.text}
              </a>
            ))}
          </nav>
        </details>
      </div>

      <div class="hidden lg:block">
        <div class="sticky top-24">
          <p class="section-title mb-3">目录</p>
          <nav class="max-h-[70vh] space-y-px overflow-y-auto" aria-label="文章目录">
            {toc.map((item) => (
              <a
                href={`#${item.slug}`}
                data-toc-link={item.slug}
                class={`toc-link ${item.depth === 3 ? 'depth-3' : ''}`}
              >
                {item.text}
              </a>
            ))}
          </nav>
        </div>
      </div>
    </>
  )
}

<script>
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
  if (links.length) {
    const headings = links
      .map((link) => document.getElementById(link.dataset.tocLink ?? ''))
      .filter((el): el is HTMLElement => Boolean(el));

    let ticking = false;
    const update = () => {
      ticking = false;
      const offset = 100;
      let current = headings[0]?.id ?? '';
      for (const heading of headings) {
        if (heading.getBoundingClientRect().top - offset <= 0) current = heading.id;
      }
      links.forEach((link) => {
        link.classList.toggle('active', link.dataset.tocLink === current);
      });
    };

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    update();
  }
</script>
