---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSettings } from '../lib/settings';
import { getStats } from '../lib/queries';
import { renderMarkdown } from '../lib/markdown';

const settings = await getSettings();
const stats = await getStats();
const { html } = await renderMarkdown(settings.about_md || '');

const initial = settings.author_name.charAt(0).toUpperCase();
---

<BaseLayout title="关于" description={settings.author_bio}>
  <div class="wrap-narrow py-12">
    <header class="flex flex-col items-start gap-5 border-b border-line pb-8 sm:flex-row sm:items-center">
      {
        settings.author_avatar ? (
          <img
            src={settings.author_avatar}
            alt={settings.author_name}
            class="h-20 w-20 shrink-0 rounded-2xl border border-line object-cover"
          />
        ) : (
          <div class="flex h-20 w-20 shrink-0 items-center justify-center rounded-2xl border border-line bg-surface font-mono text-3xl font-bold text-accent">
            {initial}
          </div>
        )
      }

      <div>
        <h1 class="text-2xl font-bold tracking-tight">{settings.author_name}</h1>
        <p class="mt-1.5 text-sm leading-relaxed text-muted">{settings.author_bio}</p>
        <div class="mt-3 flex flex-wrap gap-2">
          {
            settings.socials.map((social) => (
              <a
                href={social.url}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-sm"
              >
                {social.label}
              </a>
            ))
          }
        </div>
      </div>
    </header>

    <section class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-4">
      {
        [
          { label: '文章', value: stats.postCount },
          { label: 'TIL', value: stats.tilCount },
          { label: '专栏', value: stats.seriesCount },
          { label: '阅读', value: stats.views },
        ].map((item) => (
          <div class="card px-4 py-3">
            <p class="font-mono text-lg font-semibold">{item.value}</p>
            <p class="text-[11px] text-muted">{item.label}</p>
          </div>
        ))
      }
    </section>

    <section class="mt-6 card p-5">
      <p class="section-title mb-3">技术栈</p>
      <div class="flex flex-wrap gap-1.5">
        {
          settings.tech_stack.map((tech) => (
            <span class="rounded-md border border-line bg-surface2 px-2 py-1 font-mono text-[11px] text-textsoft">
              {tech}
            </span>
          ))
        }
      </div>
    </section>

    <div class="prose mt-8" set:html={html} />
  </div>
</BaseLayout>
