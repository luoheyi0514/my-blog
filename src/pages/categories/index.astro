---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCategories } from '../../lib/queries';

const categories = await getCategories();
const total = categories.reduce((sum, item) => sum + (item.post_count ?? 0), 0);
---

<BaseLayout title="分类" description="按技术方向浏览全部文章。">
  <div class="wrap py-10">
    <header class="mb-8">
      <h1 class="text-2xl font-bold tracking-tight">分类</h1>
      <p class="mt-1.5 text-sm text-muted">{categories.length} 个分类 · 共 {total} 篇文章</p>
    </header>

    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        categories.map((category) => (
          <a href={`/categories/${category.slug}`} class="card card-hover group flex flex-col p-5">
            <div class="flex items-start justify-between">
              <span class="text-xl">{category.icon}</span>
              <span class="font-mono text-[11px] text-muted">{category.post_count ?? 0} 篇</span>
            </div>
            <h2 class="mt-3 font-semibold tracking-tight transition group-hover:text-accent">
              {category.name}
            </h2>
            {category.description && (
              <p class="mt-1 line-clamp-2 text-xs leading-relaxed text-muted">{category.description}</p>
            )}
          </a>
        ))
      }
    </div>

    {
      categories.length === 0 && (
        <div class="card p-10 text-center text-sm text-muted">还没有分类，去后台创建。</div>
      )
    }
  </div>
</BaseLayout>
