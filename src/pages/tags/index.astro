---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTags } from '../../lib/queries';

const tags = (await getTags()).filter((tag) => (tag.count ?? 0) > 0);
const counts = tags.map((tag) => tag.count ?? 0);
const min = Math.min(...counts, 1);
const max = Math.max(...counts, 1);

const sizeOf = (count: number) => {
  if (max === min) return 1;
  const ratio = (count - min) / (max - min);
  return 0.82 + ratio * 0.7;
};
---

<BaseLayout title="标签" description="用标签快速找到相关主题的内容。">
  <div class="wrap py-10">
    <header class="mb-8">
      <h1 class="text-2xl font-bold tracking-tight">标签</h1>
      <p class="mt-1.5 text-sm text-muted">{tags.length} 个标签</p>
    </header>

    <div class="card flex flex-wrap items-baseline gap-x-3 gap-y-2.5 p-6">
      {
        tags.map((tag) => (
          <a
            href={`/tags/${tag.slug}`}
            class="group inline-flex items-baseline gap-1 text-muted transition hover:text-accent"
            style={`font-size:${sizeOf(tag.count ?? 0)}rem`}
          >
            <span class="font-medium">#{tag.name}</span>
            <span class="font-mono text-[10px] opacity-60">{tag.count}</span>
          </a>
        ))
      }
    </div>

    {
      tags.length === 0 && <div class="card p-10 text-center text-sm text-muted">还没有标签</div>
    }
  </div>
</BaseLayout>
