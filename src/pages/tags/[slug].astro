---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { countPosts, getTagBySlug, listPosts, listTils } from '../../lib/queries';
import { formatDate } from '../../lib/utils';

export const prerender = false;

const { slug } = Astro.params;
const tag = slug ? await getTagBySlug(slug) : null;
if (!tag) return Astro.rewrite('/404');

const [posts, tilItems, postCount] = await Promise.all([
  listPosts({ tagSlug: tag.slug, limit: 50 }),
  listTils({ tagSlug: tag.slug, limit: 50 }),
  countPosts({ tagSlug: tag.slug }),
]);
---

<BaseLayout title={`标签：${tag.name}`} description={`所有关于 ${tag.name} 的文章与笔记。`}>
  <div class="wrap py-10">
    <header class="mb-7">
      <p class="mb-2 font-mono text-[11px] uppercase tracking-[0.16em] text-muted">标签</p>
      <h1 class="text-2xl font-bold tracking-tight">#{tag.name}</h1>
      <p class="mt-1.5 text-sm text-muted">{postCount} 篇文章 · {tilItems.length} 条 TIL</p>
    </header>

    <section>
      <h2 class="section-title mb-3">文章</h2>
      <div class="grid gap-3">
        {posts.map((post) => <PostCard post={post} />)}
        {posts.length === 0 && <div class="card p-8 text-center text-sm text-muted">暂无相关文章</div>}
      </div>
    </section>

    {
      tilItems.length > 0 && (
        <section class="mt-10">
          <h2 class="section-title mb-3">TIL</h2>
          <div class="card divide-y divide-line">
            {tilItems.map((til) => (
              <a href={`/til#til-${til.id}`} class="block px-4 py-3 transition hover:bg-surface2">
                <p class="text-sm">{til.title}</p>
                <p class="mt-0.5 font-mono text-[10px] text-muted">{formatDate(til.published_at)}</p>
              </a>
            ))}
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>
