---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { searchAll } from '../lib/queries';
import { formatDate } from '../lib/utils';

export const prerender = false;

const query = (Astro.url.searchParams.get('q') ?? '').trim();
const { posts, tils } = query ? await searchAll(query, 30) : { posts: [], tils: [] };
const total = posts.length + tils.length;
---

<BaseLayout title={query ? `搜索：${query}` : '搜索'} noIndex>
  <div class="wrap py-10">
    <header class="mb-7">
      <h1 class="text-2xl font-bold tracking-tight">搜索</h1>
      <form action="/search" method="get" class="mt-4 flex gap-2">
        <input
          type="search"
          name="q"
          value={query}
          placeholder="输入关键词…"
          class="field max-w-md"
          autocomplete="off"
        />
        <button type="submit" class="btn btn-primary">搜索</button>
      </form>
      {query && <p class="mt-3 text-sm text-muted">「{query}」找到 {total} 条结果</p>}
    </header>

    {
      total === 0 && query && (
        <div class="card p-10 text-center text-sm text-muted">没有找到相关内容，换个关键词试试。</div>
      )
    }

    {
      posts.length > 0 && (
        <section>
          <h2 class="section-title mb-3">文章 · {posts.length}</h2>
          <div class="grid gap-3">
            {posts.map((post) => (
              <PostCard post={post} />
            ))}
          </div>
        </section>
      )
    }

    {
      tils.length > 0 && (
        <section class="mt-10">
          <h2 class="section-title mb-3">TIL · {tils.length}</h2>
          <div class="card divide-y divide-line">
            {tils.map((til) => (
              <a href={`/til#til-${til.id}`} class="block px-4 py-3 transition hover:bg-surface2">
                <p class="text-sm">{til.title}</p>
                <p class="mt-0.5 font-mono text-[10px] text-muted">{formatDate(til.published_at)}</p>
              </a>
            ))}
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>
