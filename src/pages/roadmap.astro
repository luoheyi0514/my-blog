---
import BaseLayout from '../layouts/BaseLayout.astro';
import RoadmapStages from '../components/RoadmapStages.astro';
import { getRoadmap } from '../lib/queries';

const roadmap = await getRoadmap();
const activeStatus = Astro.url.searchParams.get('status') ?? 'all';

const allItems = roadmap.flatMap((area) => area.items);
const summary = {
  total: allItems.length,
  learning: allItems.filter((item) => item.status === 'learning').length,
  mastered: allItems.filter((item) => item.status === 'mastered').length,
  planned: allItems.filter((item) => item.status === 'planned').length,
};

const filters = [
  { key: 'all', label: '全部', count: summary.total },
  { key: 'learning', label: '学习中', count: summary.learning },
  { key: 'mastered', label: '已掌握', count: summary.mastered },
  { key: 'planned', label: '计划中', count: summary.planned },
];

const statusMeta: Record<string, { label: string; dot: string }> = {
  planned: { label: '计划中', dot: 'bg-muted/50' },
  learning: { label: '学习中', dot: 'bg-amber-400' },
  mastered: { label: '已掌握', dot: 'bg-emerald-500' },
};

const areas = roadmap
  .map((area) => ({
    ...area,
    items: activeStatus === 'all' ? area.items : area.items.filter((item) => item.status === activeStatus),
  }))
  .filter((area) => area.items.length > 0);
---

<BaseLayout title="大数据开发学习路线" description="从编程基础、Hadoop 生态、Spark、数据仓库到 Flink 实时计算与 OLAP，大数据开发工程师的学习路线与进度。">
  <div class="wrap py-10">
    <header class="mb-8">
      <h1 class="text-2xl font-bold tracking-tight">大数据开发学习路线</h1>
      <p class="mt-1.5 text-sm text-muted">
        共 {summary.total} 项 · 学习中 {summary.learning} · 已掌握 {summary.mastered}
      </p>
    </header>

    <div class="mb-8">
      <RoadmapStages areas={roadmap} compact />
    </div>

    <div class="mb-8 flex flex-wrap gap-1.5">
      {
        filters.map((filter) => (
          <a
            href={filter.key === 'all' ? '/roadmap' : `/roadmap?status=${filter.key}`}
            class:list={[
              'rounded-md border px-2.5 py-1 text-xs transition',
              activeStatus === filter.key
                ? 'border-transparent bg-text font-medium text-bg'
                : 'border-line text-muted hover:text-text',
            ]}
          >
            {filter.label}
            <span class="ml-1 font-mono text-[10px] opacity-60">{filter.count}</span>
          </a>
        ))
      }
    </div>

    <div class="space-y-10">
      {
        areas.map((area) => (
          <section id={`area-${area.id}`} class="scroll-mt-24">
            <div class="mb-4 flex items-center gap-3">
              <h2 class="text-base font-semibold tracking-tight">{area.name}</h2>
              <div class="h-px flex-1 bg-line" />
              <span class="font-mono text-[10px] text-muted">{area.items.length} 项</span>
            </div>

            <div class="grid gap-3 sm:grid-cols-2">
              {area.items.map((item) => (
                <div class="card p-4">
                  <div class="flex items-start justify-between gap-3">
                    <div class="flex items-center gap-2">
                      <span class="text-base">{item.icon}</span>
                      <span class="text-sm font-medium">{item.name}</span>
                    </div>
                    <span class="flex shrink-0 items-center gap-1.5 text-[10px] text-muted">
                      <span class={`h-1.5 w-1.5 rounded-full ${statusMeta[item.status]?.dot ?? 'bg-muted'}`} />
                      {statusMeta[item.status]?.label ?? item.status}
                    </span>
                  </div>

                  <div class="mt-3 flex items-center gap-2">
                    <div class="h-1 flex-1 overflow-hidden rounded-full bg-surface2">
                      <div
                        class:list={[
                          'h-full rounded-full',
                          item.status === 'mastered' ? 'bg-emerald-500' : 'bg-accent',
                        ]}
                        style={`width:${item.progress}%`}
                      />
                    </div>
                    <span class="w-8 text-right font-mono text-[10px] text-muted">{item.progress}%</span>
                  </div>

                  {item.start_date && (
                    <p class="mt-2 font-mono text-[10px] text-muted">
                      {item.start_date} {item.end_date ? `→ ${item.end_date}` : '→ 现在'}
                    </p>
                  )}

                  {item.note && <p class="mt-2 text-[11px] leading-relaxed text-muted">{item.note}</p>}

                  {
                    item.links && item.links.length > 0 && (
                      <div class="mt-2 flex flex-wrap gap-1.5">
                        {item.links.map((link) => (
                          <a href={link.href} class="chip text-[10px]">
                            {link.label ?? link.type}
                          </a>
                        ))}
                      </div>
                    )
                  }
                </div>
              ))}
            </div>
          </section>
        ))
      }
    </div>

    {
      areas.length === 0 && (
        <div class="card p-10 text-center text-sm text-muted">暂无内容，去后台维护学习路线。</div>
      )
    }
  </div>
</BaseLayout>
