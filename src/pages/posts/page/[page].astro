---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Pagination from '../../../components/Pagination.astro';
import PostList from '../../../components/PostList.astro';
import { countPosts, getCategories, listPosts } from '../../../lib/queries';
import { getSettings } from '../../../lib/settings';

export const prerender = false;

const current = Number(Astro.params.page);
if (!Number.isInteger(current) || current < 1) {
  return Astro.redirect('/posts');
}

const settings = await getSettings();
const perPage = settings.posts_per_page || 10;

const [posts, total, categories] = await Promise.all([
  listPosts({ limit: perPage, offset: (current - 1) * perPage }),
  countPosts(),
  getCategories(),
]);

const totalPages = Math.max(1, Math.ceil(total / perPage));
if (current > totalPages && totalPages > 0) {
  return Astro.redirect('/posts');
}
---

<BaseLayout title={`全部文章 · 第 ${current} 页`} description="所有技术笔记、踩坑记录与学习总结。">
  <div class="wrap py-10">
    <header class="mb-7">
      <h1 class="text-2xl font-bold tracking-tight">全部文章</h1>
      <p class="mt-1.5 text-sm text-muted">共 {total} 篇 · 第 {current} / {totalPages} 页</p>
    </header>

    <PostList posts={posts} categories={categories} />
    <Pagination current={current} totalPages={totalPages} basePath="/posts" />
  </div>
</BaseLayout>
