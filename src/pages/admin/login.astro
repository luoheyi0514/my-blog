---
import '../../styles/global.css';
import { checkRateLimit, clearFailures, createSession, login, recordFailure, setSessionCookie } from '../../lib/auth';
import { getSettings } from '../../lib/settings';

export const prerender = false;

const settings = await getSettings();
const nextParam = Astro.url.searchParams.get('next') ?? '/admin';
const safeNext = nextParam.startsWith('/') ? nextParam : '/admin';

let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const email = String(form.get('email') ?? '');
  const password = String(form.get('password') ?? '');
  const key = email.trim().toLowerCase();

  const limited = checkRateLimit(key);
  if (limited) {
    error = limited;
  } else {
    const result = await login(email, password);
    if ('error' in result) {
      recordFailure(key);
      error = result.error;
    } else {
      clearFailures(key);
      const { token, expires } = await createSession(result.user.id);
      setSessionCookie(Astro.cookies, token, expires);
      return Astro.redirect(safeNext, 303);
    }
  }
}

const isDev = import.meta.env.DEV;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>登录 · {settings.site_name}</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      (() => {
        try {
          const mode = localStorage.getItem('theme') || 'system';
          const dark =
            mode === 'dark' ||
            (mode === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
          document.documentElement.classList.toggle('dark', dark);
        } catch (e) {}
      })();
    </script>
  </head>

  <body class="relative flex min-h-screen items-center justify-center bg-bg p-5 text-text">
    <div class="hero-grid pointer-events-none absolute inset-0"></div>

    <div class="relative w-full max-w-sm">
      <div class="mb-6 flex items-center gap-2.5">
        <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-text font-mono text-sm font-bold text-bg">
          {settings.site_name.charAt(0).toUpperCase()}
        </span>
        <div>
          <p class="text-sm font-semibold leading-tight">{settings.site_name}</p>
          <p class="text-[11px] text-muted">写作后台</p>
        </div>
        <a href="/" class="ml-auto text-[11px] text-muted hover:text-accent">← 回前台</a>
      </div>

      <form method="post" class="card p-6">
        <h1 class="text-base font-semibold">登录</h1>
        <p class="mt-1 text-xs text-muted">只有站点的作者可以进入后台</p>

        {
          error && (
            <p class="mt-4 rounded-md border border-red-500/40 bg-red-500/10 px-3 py-2 text-xs text-red-600 dark:text-red-400">
              {error}
            </p>
          )
        }

        <div class="mt-5 space-y-3">
          <div>
            <label class="label" for="email">邮箱</label>
            <input id="email" name="email" type="email" required autocomplete="username" class="field" />
          </div>
          <div>
            <label class="label" for="password">密码</label>
            <input
              id="password"
              name="password"
              type="password"
              required
              autocomplete="current-password"
              class="field"
            />
          </div>
        </div>

        <button type="submit" class="btn btn-primary mt-5 w-full">登录</button>

        {
          isDev && (
            <p class="mt-4 rounded-md bg-surface2 px-3 py-2 font-mono text-[10px] leading-relaxed text-muted">
              本地默认账号：admin@local.dev / admin123456
              <br />
              可在 .env 中修改 ADMIN_EMAIL、ADMIN_PASSWORD
            </p>
          )
        }
      </form>
    </div>
  </body>
</html>
