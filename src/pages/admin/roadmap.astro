---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getRoadmap } from '../../lib/queries';
import { run, scalar } from '../../lib/db';

export const prerender = false;

const user = Astro.locals.user!;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? '');
  const id = Number(form.get('id') ?? 0);

  if (action === 'create-area') {
    const name = String(form.get('name') ?? '').trim();
    if (name) {
      const max = (await scalar<number>('SELECT COALESCE(MAX(sort_order),0) FROM roadmap_areas')) ?? 0;
      await run('INSERT INTO roadmap_areas (name, sort_order) VALUES (?, ?)', [name, max + 1]);
    }
  } else if (action === 'delete-area' && id) {
    await run('DELETE FROM roadmap_links WHERE item_id IN (SELECT id FROM roadmap_items WHERE area_id = ?)', [id]);
    await run('DELETE FROM roadmap_items WHERE area_id = ?', [id]);
    await run('DELETE FROM roadmap_areas WHERE id = ?', [id]);
  } else if (action === 'create-item') {
    const areaId = Number(form.get('area_id') ?? 0);
    const name = String(form.get('name') ?? '').trim();
    if (areaId && name) {
      const max = (await scalar<number>('SELECT COALESCE(MAX(sort_order),0) FROM roadmap_items WHERE area_id = ?', [areaId])) ?? 0;
      await run(
        `INSERT INTO roadmap_items (area_id, name, icon, status, progress, start_date, end_date, note, sort_order)
         VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)`,
        [
          areaId,
          name,
          String(form.get('icon') ?? '') || null,
          String(form.get('status') ?? 'planned'),
          Number(form.get('progress') ?? 0),
          String(form.get('start_date') ?? '') || null,
          String(form.get('end_date') ?? '') || null,
          String(form.get('note') ?? '') || null,
          max + 1,
        ],
      );
    }
  } else if (action === 'update-item' && id) {
    await run(
      `UPDATE roadmap_items SET name = ?, icon = ?, status = ?, progress = ?, start_date = ?, end_date = ?, note = ?, sort_order = ?
       WHERE id = ?`,
      [
        String(form.get('name') ?? '').trim(),
        String(form.get('icon') ?? '') || null,
        String(form.get('status') ?? 'planned'),
        Math.min(100, Math.max(0, Number(form.get('progress') ?? 0))),
        String(form.get('start_date') ?? '') || null,
        String(form.get('end_date') ?? '') || null,
        String(form.get('note') ?? '') || null,
        Number(form.get('sort_order') ?? 0),
        id,
      ],
    );
  } else if (action === 'delete-item' && id) {
    await run('DELETE FROM roadmap_links WHERE item_id = ?', [id]);
    await run('DELETE FROM roadmap_items WHERE id = ?', [id]);
  }

  return Astro.redirect('/admin/roadmap', 303);
}

const areas = await getRoadmap();
const statusOptions = [
  { value: 'planned', label: '计划中' },
  { value: 'learning', label: '学习中' },
  { value: 'mastered', label: '已掌握' },
];
---

<AdminLayout title="学习路线" user={user}>
  <div class="mx-auto max-w-4xl">
    <form method="post" class="card flex items-end gap-2 p-3">
      <input type="hidden" name="action" value="create-area" />
      <div class="flex-1">
        <label class="label">新增领域</label>
        <input name="name" placeholder="例如：前端 / 后端 / 计算机基础" class="field" />
      </div>
      <button type="submit" class="btn btn-accent btn-sm mb-0.5">添加</button>
    </form>

    <div class="mt-6 space-y-8">
      {
        areas.map((area) => (
          <section>
            <div class="mb-2 flex items-center gap-2">
              <h2 class="text-sm font-semibold">{area.name}</h2>
              <span class="font-mono text-[10px] text-muted">{area.items.length} 项</span>
              <form method="post" class="ml-auto">
                <input type="hidden" name="action" value="delete-area" />
                <input type="hidden" name="id" value={area.id} />
                <button
                  type="submit"
                  class="btn btn-sm btn-danger"
                  onclick="return confirm('删除该领域及其中所有技术项？')"
                >
                  删除领域
                </button>
              </form>
            </div>

            <div class="space-y-1.5">
              {area.items.map((item) => (
                <form method="post" class="card flex flex-wrap items-end gap-2 p-3">
                  <input type="hidden" name="id" value={item.id} />

                  <div class="w-12">
                    <label class="label">图标</label>
                    <input name="icon" value={item.icon ?? ''} class="field text-center" />
                  </div>

                  <div class="min-w-32 flex-1">
                    <label class="label">名称</label>
                    <input name="name" value={item.name} class="field" />
                  </div>

                  <div class="w-24">
                    <label class="label">状态</label>
                    <select name="status" class="field text-xs">
                      {statusOptions.map((option) => (
                        <option value={option.value} selected={item.status === option.value}>
                          {option.label}
                        </option>
                      ))}
                    </select>
                  </div>

                  <div class="w-16">
                    <label class="label">进度%</label>
                    <input name="progress" type="number" min="0" max="100" value={item.progress} class="field text-center text-xs" />
                  </div>

                  <div class="w-32">
                    <label class="label">开始</label>
                    <input name="start_date" value={item.start_date ?? ''} placeholder="2026-01" class="field text-xs" />
                  </div>

                  <div class="w-32">
                    <label class="label">结束</label>
                    <input name="end_date" value={item.end_date ?? ''} placeholder="2026-06" class="field text-xs" />
                  </div>

                  <div class="w-14">
                    <label class="label">排序</label>
                    <input name="sort_order" type="number" value={item.sort_order} class="field text-center text-xs" />
                  </div>

                  <div class="min-w-40 flex-[1.2]">
                    <label class="label">备注</label>
                    <input name="note" value={item.note ?? ''} class="field text-xs" />
                  </div>

                  <div class="flex items-center gap-1 pb-0.5">
                    <button type="submit" name="action" value="update-item" class="btn btn-sm">保存</button>
                    <button
                      type="submit"
                      name="action"
                      value="delete-item"
                      class="btn btn-sm btn-danger"
                      onclick="return confirm('删除该技术项？')"
                    >
                      删除
                    </button>
                  </div>
                </form>
              ))}
            </div>

            <form method="post" class="mt-1.5 flex flex-wrap items-end gap-2 rounded-lg border border-dashed border-line p-3">
              <input type="hidden" name="action" value="create-item" />
              <input type="hidden" name="area_id" value={area.id} />
              <input name="icon" placeholder="图标" class="field h-8 w-12 py-1 text-center text-xs" />
              <input name="name" placeholder="新增技术项" class="field h-8 max-w-48 flex-1 py-1 text-xs" required />
              <select name="status" class="field h-8 w-24 py-1 text-xs">
                {statusOptions.map((option) => <option value={option.value}>{option.label}</option>)}
              </select>
              <input name="progress" type="number" min="0" max="100" value="0" class="field h-8 w-16 py-1 text-center text-xs" />
              <button type="submit" class="btn btn-sm">添加</button>
            </form>
          </section>
        ))
      }
    </div>
  </div>
</AdminLayout>
