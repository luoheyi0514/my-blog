---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSeriesList } from '../../lib/queries';
import { formatDate } from '../../lib/utils';

const seriesList = await getSeriesList();
---

<BaseLayout title="专栏" description="按主题组织的系列教程，适合系统学习。">
  <div class="wrap py-10">
    <header class="mb-8">
      <h1 class="text-2xl font-bold tracking-tight">专栏</h1>
      <p class="mt-1.5 text-sm text-muted">{seriesList.length} 个专栏 · 按顺序阅读效果更好</p>
    </header>

    <div class="grid gap-4 sm:grid-cols-2">
      {
        seriesList.map((series) => (
          <a href={`/series/${series.slug}`} class="card card-hover group flex flex-col p-5">
            <div class="flex items-center justify-between">
              <span
                class:list={[
                  'rounded border px-1.5 py-px font-mono text-[10px]',
                  series.status === 'completed'
                    ? 'border-accent/40 bg-accentsoft text-accent'
                    : 'border-line text-muted',
                ]}
              >
                {series.status === 'completed' ? '已完结' : '连载中'}
              </span>
              <span class="font-mono text-[11px] text-muted">{series.post_count ?? 0} 篇</span>
            </div>

            <h2 class="mt-3 text-[1.05rem] font-semibold leading-snug tracking-tight transition group-hover:text-accent">
              {series.name}
            </h2>
            {series.description && (
              <p class="mt-1.5 line-clamp-2 text-xs leading-relaxed text-muted">{series.description}</p>
            )}

            {series.updated_at && (
              <p class="mt-4 font-mono text-[10px] text-muted">最近更新 {formatDate(series.updated_at)}</p>
            )}
          </a>
        ))
      }
    </div>

    {
      seriesList.length === 0 && (
        <div class="card p-10 text-center text-sm text-muted">还没有专栏，去后台创建。</div>
      )
    }
  </div>
</BaseLayout>
